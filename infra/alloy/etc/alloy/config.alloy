logging {
  level = "warn"
}

livedebugging {
  enabled = true
}

loki.source.file "windy" {
  forward_to = [loki.process.decode.receiver]

  targets = [
    { __path__ = "/data/weather/logs/windy/**/*.jsonl" },
  ]

  file_match {
    enabled = true
    sync_period = "10s"
    ignore_older_than = "1000h"
  }
}

loki.process "decode" {
  forward_to = [loki.write.pike_loki.receiver]

  stage.json {
    regex = ".*"
  }

  stage.structured_metadata {
    values = {
      c = "", 
      s = "", 
      g = "", 
      t = "", 
      r = "", 
      p = "", 
      h = "", 
      b = "", 
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339"
  }

  stage.static_labels {
      values = {
        node = "windy",
      }
  }
}

loki.write "pike_loki" {
  endpoint {
    url = "http://loki.pike/loki/api/v1/push"
  }
}